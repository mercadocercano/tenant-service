# Tenant Service — Environment Variables

# Server
PORT=8120
PROMETHEUS_ENABLED=true

# JWT (validación de claim tenant_id, ver middleware TenantValidation)
JWT_SECRET=

# PostgreSQL — tenant_db
# RULE-09 / RULE-10 (PLAT-E29): el runtime corre SIEMPRE bajo el rol de aplicación least-privilege
# tenant_app (NOBYPASSRLS) — NUNCA como postgres/superuser, que bypasearía la RLS de
# tenant_config/tenant_settings/points_of_sale (FORCE ROW LEVEL SECURITY no aplica a superusers →
# RLS "activa" pero nunca ejercida). tenant_settings gobierna configuración fiscal (AFIP, tipos de
# factura), monetaria (monedas, tasa de cambio) y de crédito (límites, días) del tenant — L4. El
# rol se crea con migrations/roles/tenant_app.sql. La password se fija out-of-band
# (`ALTER ROLE tenant_app PASSWORD '...'`) y NUNCA se commitea; el valor de abajo es solo el
# default de dev local (docker-compose raíz usa ${TENANT_DB_PASSWORD:-tenant_app123}).
DB_HOST=localhost
DB_PORT=5432
DB_USER=tenant_app
DB_PASSWORD=tenant_app123
DB_NAME=tenant_db

# PostgreSQL — eventbus (segunda conexión, DB compartida con otros servicios del ecosistema)
# Mismo rol tenant_app en las DOS conexiones (D3, PLAT-E29 T3): tenant-service SOLO PUBLICA
# eventos (INSERT en event_bus), nunca los consume — CERO grants sobre event_consumers.
EVENTBUS_DB_HOST=localhost
EVENTBUS_DB_PORT=5432
EVENTBUS_DB_USER=tenant_app
EVENTBUS_DB_PASSWORD=tenant_app123
EVENTBUS_DB_NAME=eventbus
